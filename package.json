{
  "name": "online-toolkit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://tools.136136136.xyz/",
  "repository": {
    "type": "git",
    "url": "https://github.com/SchweppesSoda/online-toolkit.git"
  },
  "description": "部署在 Cloudflare Workers 上的隐私友好型在线工具集合。",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "exifreader": "4.41.3",
    "qr-scanner": "1.4.2",
    "qrcode": "1.5.4",
    "scanic": "1.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "workerd@1.20260721.1": true
  }
}
